{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MqttBroker2: Build",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "MqttBroker2: USB Upload",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Mode", "Upload"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "MqttBroker2: Monitor",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Mode", "Monitor"],
      "problemMatcher": []
    }
  ]
}
